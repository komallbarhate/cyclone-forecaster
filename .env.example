# ============================================================
# CycloneShield — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- Google Earth Engine ---
# Option 1: Service account (recommended for CI/CD)
# GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_FILE=path/to/service-account-key.json
#
# Option 2: OAuth (for interactive local use; run `earthengine authenticate`)
# GEE_PROJECT=your-gee-cloud-project-id

# --- Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here
# Model to use (fallback list is tried if this one fails)
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram Dispatch ---
# Optional: Only needed for live alert dispatch
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Comma-separated list of chat IDs to notify
TELEGRAM_TEST_CHAT_ID=your_chat_id_here
# Set to false ONLY in production; default true = safe dry-run
DRY_RUN=true

# --- Backend ---
# Port for the FastAPI backend (default 8000)
BACKEND_PORT=8000
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Pipeline ---
# Directory for cached processed data
PROCESSED_DIR=data/processed
RAW_DIR=data/raw

# --- Scenario ---
# Default scenario name (must match a file in config/scenarios/)
DEFAULT_SCENARIO=fani_2019
